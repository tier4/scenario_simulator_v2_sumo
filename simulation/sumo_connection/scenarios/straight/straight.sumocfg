<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="straight.net.xml"/>
        <route-files value="straight.rou.xml"/>
    </input>
    <time>
        <begin value="0.0"/>
        <end value="60.0"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <collision.action value="warn"/>
    </processing>
    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
